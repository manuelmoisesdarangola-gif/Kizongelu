# =============================================================================
# KIZONGELU — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (FASE 18)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de Dados PostgreSQL (Neon / Supabase)
# -----------------------------------------------------------------------------
# String de ligação pooled para produção e direct URL para migrações Prisma:
DATABASE_URL="postgresql://kizongelu_user:sua_senha_segura@ep-kizongelu-production.neon.tech/kizongelu_db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://kizongelu_user:sua_senha_segura@ep-kizongelu-production.neon.tech/kizongelu_db?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Domínio e Servidor de Produção
# -----------------------------------------------------------------------------
APP_URL="https://kizongelu.ao"
NODE_ENV="production"
PORT=3000

# -----------------------------------------------------------------------------
# 3. Autenticação e Segurança (NextAuth / JWT)
# -----------------------------------------------------------------------------
AUTH_SECRET="gerar_com_openssl_rand_base64_32"
NEXTAUTH_SECRET="gerar_com_openssl_rand_base64_32"
NEXTAUTH_URL="https://kizongelu.ao"

# -----------------------------------------------------------------------------
# 4. Motor de IA e Cálculo Técnico
# -----------------------------------------------------------------------------
GEMINI_API_KEY="seu_gemini_api_key_aistudio"
AI_PROVIDER="gemini"

# -----------------------------------------------------------------------------
# 5. Monitorização, Sentry & Vercel Analytics
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN="https://exemplo@o123456.ingest.sentry.io/7891011"
SENTRY_DSN="https://exemplo@o123456.ingest.sentry.io/7891011"
SENTRY_ENVIRONMENT="production"
VERCEL_ANALYTICS_ID="kizongelu_va_prod_2026"

# -----------------------------------------------------------------------------
# 6. Pagamentos em Kwanzas (Multicaixa Express & BAI)
# -----------------------------------------------------------------------------
MULTICAIXA_ENTIDADE="00123"
MULTICAIXA_SUBENTIDADE="99"
BAI_API_KEY="bai_live_secret_key"
BAI_IBAN="AO06.0040.0000.1234.5678.9012.3"
BAI_BENEFICIARIO="Kizongelu Tecnologias de Engenharia Lda"

# -----------------------------------------------------------------------------
# 7. Armazenamento de Comprovativos e PDFs (S3 / Supabase Storage)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"
STORAGE_BUCKET="comprovativos-obras"

# -----------------------------------------------------------------------------
# 8. Backups Automáticos Diários
# -----------------------------------------------------------------------------
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_S3_BUCKET="kizongelu-backups-angola"
BACKUP_RETENTION_DAYS="30"
